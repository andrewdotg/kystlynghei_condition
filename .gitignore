# Data and generated outputs are not tracked in git - everything here is
# regenerated by running R/model.R and the modules in R/modules/. See the
# README for how each module's expected input/output paths are configured.
data/
# outputs are regenerated, except the fitted model, which python/ae_sj_model.py reads
outputs/*
!outputs/model/
outputs/model/*
!outputs/model/FINAL_AE_SJ_covadj_model.json
*.csv
*.rds
*.tif
*.tiff
*.nc
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.png
# ...except the figures the report needs
!report/fig_burn_example_*.png
!report/img/*.png
*.jpg
*.jpeg
*.pdf
Thumbs.db
.DS_Store

# Word documents (methodology, Norwegian report) are kept outside the repo
# (../kystlynghei_word_documents/)
*.docx
~$*

# Report data export and the rendered report (regenerated on render; the
# published copy is docs/index.html)
report/data/
report/kystlynghei_condition_report.html
report/kystlynghei_condition_report_files/
report/kystlynghei_condition_report_cache/
# Condensed Word version of the report - kept local, not part of the repo
report/kystlynghei_condition_report_short.*
report/kystlynghei_condition_report_short_files/

# R
.Rhistory
.RData
.Rproj.user/

# Python
__pycache__/
*.pyc
.venv/
# Python outputs (regenerated by the scripts in python/)
python/mi_aesj_annual_results/
python/mi_dnbr_burn_results/
python/validation_registered_burns/
*.npz
*.gpkg

# Local input data dropped in by hand (e.g. inputs/MI_kystlynghei.shp) -
# already covered by the *.shp/*.csv/etc. patterns above, listed here too so
# the whole folder's intent is obvious at a glance.
inputs/

# Machine-specific VS Code settings (quarto.path etc.) - the absolute path
# is only correct on the machine it was set up on. Ignoring just this file,
# not the whole .vscode/ folder, in case shareable config (e.g. recommended
# extensions) gets added there later.
.vscode/settings.json

# Banner graphic (not used in the report)
python/diagnostics/banner_figure.py
report/img/banner.png
